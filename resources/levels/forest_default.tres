[gd_resource type="Resource" script_class="ForestStats" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/levels/ForestStats.cs" id="1_stats"]
[ext_resource type="Script" path="res://scripts/levels/ForestLayer.cs" id="2_layer"]

[sub_resource type="Resource" id="Resource_tall"]
script = ExtResource("2_layer")
