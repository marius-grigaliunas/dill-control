SpacingM = 26.0
MaxSlopeDeg = 25.0

[sub_resource type="Resource" id="Resource_small"]
script = ExtResource("2_layer")
Prefixes = PackedStringArray("prp_tree_small_")
Density = 2.0
SpacingM = 11.0
MaxSlopeDeg = 30.0

[sub_resource type="Resource" id="Resource_under"]
script = ExtResource("2_layer")
Prefixes = PackedStringArray("prp_vine_shrub_")
Density = 3.0
SpacingM = 7.0
MaxSlopeDeg = 35.0

[resource]
resource_name = "ForestDefault"
script = ExtResource("1_stats")
