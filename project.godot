[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Hitbox"
3d_physics/layer_5="Water"
3d_physics/layer_6="Prop"
3d_physics/layer_7="Projectile"
3d_physics/layer_8="HordeHitbox"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_size=2048

[shader_globals]

sky_eye_up={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
sky_horizon_dip={
"type": "float",
"value": 0.0
}
sky_atmosphere_blend={
"type": "float",
"value": 1.0
}
